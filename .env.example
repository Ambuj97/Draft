# Copy to .env (gitignored) and fill in.

# Google Maps SDK key — used for the map on iOS + Android.
# Create at https://console.cloud.google.com/ :
#   1. New project (or reuse one)
#   2. Enable "Maps SDK for iOS" and "Maps SDK for Android"
#   3. APIs & Services > Credentials > Create credentials > API key
#   4. Restrict the key:
#        iOS:     app bundle id  com.draft.app
#        Android: package  com.draft.app  + your debug/release SHA-1
GOOGLE_MAPS_API_KEY=
